# Production settings read by docker-compose.prod.yml. Copy to `.env` on the host and fill in; never commit `.env`.

# Password of the `contorno` user in the shared MySQL (home-server).
CONTORNO_DB_PASSWORD=
# Signs access tokens (HS256); at least 32 characters. Generate with: openssl rand -hex 32
CONTORNO_JWT_SECRET=
# OAuth "web" client id from Google Cloud (also used by the Android app). Empty turns "Entrar com Google" off.
CONTORNO_GOOGLE_CLIENT_ID=
